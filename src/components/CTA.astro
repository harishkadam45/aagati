---
import { contactHref, site } from '../data/site';
const chips = ['Enterprise-grade Security', 'NDA on Request', 'DPDP · SOC2 · ISO Ready', 'Free Discovery Call'];
---

<section id="contact" class="section relative overflow-hidden bg-white">
  <div class="container-x">
    <div class="relative isolate overflow-hidden rounded-[2rem] bg-navy-950 px-6 py-16 text-center sm:px-12 lg:py-20">
      <div class="pointer-events-none absolute -left-20 -top-32 -z-10 size-96 rounded-full bg-brand-600/40 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -right-20 -z-10 size-96 rounded-full bg-brand-500/25 blur-3xl"></div>

      <span class="eyebrow mb-4 text-brand-500">Get Started</span>
      <h2 class="mx-auto max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl">
        Ready to transform your business? Let's start the conversation.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
        From first assessment to production-grade AI, Aagati turns enterprise ambition into measurable outcomes — in days,
        not quarters.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={contactHref} class="btn-primary px-8 text-base">Book a Discovery Call</a>
        <a href={`mailto:${site.email}`} class="btn border-white/25 bg-white/5 px-8 text-base text-white hover:bg-white hover:text-navy-950">
          {site.email}
        </a>
      </div>
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm font-semibold text-slate-300">
        {
          chips.map((c) => (
            <li class="flex items-center gap-2">
              <svg class="size-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
