---
import { services } from '../data/site';
---

<section id="services" class="section bg-brand-50">
  <div class="container-x">
    <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow mb-3">Solutions That Work</span>
        <h2 class="heading-section">End-to-End Enterprise Transformation</h2>
        <p class="lead mt-4">Not just another tech vendor — your partner in measurable transformation.</p>
      </div>
      <a href="#services" class="btn-primary shrink-0 self-start md:self-auto">
        View All Services
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={s.href} class="card group flex flex-col overflow-hidden">
            <div class="overflow-hidden bg-slate-100">
              <img
                src={s.img}
                alt={s.alt}
                class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                width="480"
                height="300"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="mb-2 text-[11px] font-bold uppercase tracking-wider text-brand-600">{s.tag}</p>
              <h3 class="heading-card">{s.title}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed">{s.desc}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-600">
                Learn more
                <span class="transition group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
