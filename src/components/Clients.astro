---
import { clients } from '../data/site';

const half = Math.ceil(clients.length / 2);
const rows = [
  { items: clients.slice(0, half), anim: 'animate-marquee' },
  { items: clients.slice(half), anim: 'animate-marquee-reverse' },
];
// each row is repeated 4× so the track is always wider than the screen; it scrolls by half (2 sets) for a seamless loop
const repeat = <T,>(a: T[]) => [...a, ...a, ...a, ...a];
---

<section class="section overflow-hidden bg-white" aria-label="Clients">
  <div class="container-x mb-12 text-center">
    <span class="eyebrow mb-3">Our Clients</span>
    <h2 class="heading-section">Trusted by enterprise teams shipping at scale</h2>
    <p class="lead mx-auto mt-4 max-w-2xl">
      Global leaders across finance, manufacturing, media and technology rely on Aagati to ship AI and engineering outcomes.
    </p>
  </div>

  <div class="group mx-auto max-w-[1440px] space-y-4 [mask-image:linear-gradient(to_right,transparent,#000_6%,#000_94%,transparent)] sm:space-y-5">
    {
      rows.map((row) => (
        <div class="overflow-hidden py-2">
          <ul class={`flex w-max ${row.anim} group-hover:[animation-play-state:paused] motion-reduce:animate-none`}>
            {repeat(row.items).map((c, i) => (
              <li
                aria-hidden={i >= row.items.length ? 'true' : undefined}
                class="mr-4 flex h-24 w-44 shrink-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200/70 bg-gray-100 px-4 shadow-[0_1px_2px_rgba(11,19,42,0.04)] transition-[border-color,box-shadow] duration-200 hover:border-brand-500/40 hover:shadow-md sm:mr-5 sm:w-48"
              >
                <span class="flex h-10 items-center justify-center">
                  <img
                    src={c.logo}
                    alt={`${c.name} logo`}
                    class={`${c.h} max-w-[142px] object-contain`}
                    decoding="async"
                    draggable="false"
                  />
                </span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">{c.sector}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
