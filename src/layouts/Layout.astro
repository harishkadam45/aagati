---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Consulting & Software Development Company | Aagati',
  description = 'Aagati engineers enterprise outcomes — AI, data and product engineering shipped from assessment to production in days, not quarters.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0071cc" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
