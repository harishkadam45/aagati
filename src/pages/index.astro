---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import CaseStudies from '../components/CaseStudies.tsx';
import Advantage from '../components/Advantage.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { caseStudies } from '../data/site';
---

<Layout>
  <Header client:load />
  <main>
    <Hero />
    <Clients />
    <About />
    <Services />

    <section id="case-studies" class="section bg-white">
      <div class="container-x">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <span class="eyebrow mb-3">Outcomes. Proven.</span>
          <h2 class="heading-section">Outcomes Delivered. Every Time.</h2>
          <p class="lead mt-4">Real-world case studies showcasing how we deliver measurable value.</p>
        </div>
        <CaseStudies client:visible items={caseStudies} />
      </div>
    </section>

    <Advantage />
    <CTA />
  </main>
  <Footer />
</Layout>
